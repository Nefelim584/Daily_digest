# Mistral AI API key (get one from https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# 12-Factor App & Container Shared Volume Settings
# Destination directory for generated digests (synced with companion containers e.g. utility_bot)
DIGEST_OUTPUT_DIR=data/digests
# BOT_DIGESTS_PATH=/app/data/digests

# Network host interface (0.0.0.0 enables access from companion containers in Docker network)
HOST=0.0.0.0
PORT=8000

# Default collection time window in hours
DIGEST_DEFAULT_HOURS=24
