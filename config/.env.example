# ==============================================================================
# Daily Digest Environment Configuration (.env)
# Note: Zero external AI API keys are required (TextRank summarization, TF-IDF
# clustering, and HTML web-search fallback run entirely local in the binary).
# ==============================================================================

# Destination directory for generated digests
DIGEST_OUTPUT_DIR=data/digests
# BOT_DIGESTS_PATH=/app/data/digests

# Default output format: markdown, text, or html
DIGEST_OUTPUT_FORMAT=markdown

# Network server settings (0.0.0.0 enables access from companion containers in Docker)
HOST=0.0.0.0
PORT=8000

# Default collection time window in hours
DIGEST_DEFAULT_HOURS=24

# RSSHub instance (public or self-hosted container e.g. http://localhost:1200)
RSSHUB_BASE_URL=https://rsshub.app
