# ==============================================================================
# Daily Digest Multi-Container Configuration (.env)
# Note: Zero external AI API keys are required (TextRank summarization, TF-IDF
# clustering, and HTML web-search fallback run entirely local in the binary).
# ==============================================================================

# Container port exposed on the host
PORT=8000

# Shared volume paths between Daily Digest and consumer (e.g. Utility Bot)
DIGEST_OUTPUT_DIR=/app/data/digests
BOT_DIGESTS_PATH=/app/data/digests

# Default output format: markdown, text, or html
DIGEST_OUTPUT_FORMAT=markdown

# Default time window in hours
DIGEST_DEFAULT_HOURS=24

# Cron schedule for Ofelia scheduler (e.g. @daily, @hourly, or "0 0 6 * * *")
DIGEST_CRON_SCHEDULE=@daily

# RSSHub instance (public or self-hosted container e.g. http://rsshub:1200)
RSSHUB_BASE_URL=https://rsshub.app
